<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Mods menu's in-game browser for Nexus Mods: Chromium (CEF, through CefSharp) drawn off-screen. The Mods menu
    starts it, shows its pages inside the game and sends it the mouse and keyboard. When the player downloads a mod
    file on Nexus, it saves it, repacks .7z / .rar into a plain .zip, and tells the menu, which installs it.
    .NET Framework 4.8 (part of Windows 10 and 11), so no .NET runtime ships with it. Built and released by
    .github/workflows/browser-release.yml on Windows (it adds the Visual C++ runtime files CEF needs next to it).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.1.0</Version>
    <AssemblyName>NomadBrowser</AssemblyName>
    <RootNamespace>NomadBrowser</RootNamespace>
    <Company>AkoRit</Company>
    <Product>Nomad Mod Manager browser</Product>
    <DebugType>none</DebugType>
    <CefSharpAnyCpuSupport>false</CefSharpAnyCpuSupport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.OffScreen" Version="152.0.150" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <!-- SharpCompress is built against these newer versions than its package asks for; without them, opening a .7z or .rar
         fails with "Could not load file or assembly 'System.Memory, Version=4.0.5.0'". -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
